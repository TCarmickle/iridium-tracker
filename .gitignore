# the bundled Python runtime (rebuilt with build/build_runtime.py, ~550 MB)
/python/

# your own data - never committed: antenna location, captures, catalog, map cache
/data/
# (older versions kept it inside app)
app/settings.json
app/output*
app/catalog-data*.json
app/catalog.txt
app/iridium-names.tle
app/tiles/
app/tracker-error.log

# generated
LICENSES/third-party/
dist/
__pycache__/
*.pyc

# build scratch
build/_*

# written by pocket_trk while it runs (decoded GNSS orbits cache)
app/pocketsdr/.pocket_navdata.csv
